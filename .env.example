# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/incidentiq
DB_USER=incidentiq
DB_PASSWORD=incidentiq_secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP=localhost:9092

# Security & JWT
JWT_SECRET=incidentiq-super-secret-key-that-is-at-least-256-bits-long-for-hmac-sha256
