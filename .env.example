REFRESH_TOKEN_EXPIRATION_DAYS=7

# Bootstrap Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@incidentiq.local
ADMIN_BOOTSTRAP_PASSWORD=AdminInitialPassword123!

# AI & LLM Integration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
